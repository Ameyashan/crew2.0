{
  "manifest_version": 3,
  "name": "Jugaadu — Application Autofill",
  "version": "0.1.0",
  "description": "Fills job applications on Greenhouse, Ashby, and Lever with the resume and answers your Jugaadu crew tailored for that job. You review and submit.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://jugaadu.app/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Jugaadu" },
  "externally_connectable": {
    "matches": ["https://jugaadu.app/*", "http://localhost:3000/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
