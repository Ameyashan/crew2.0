{
  "crons": [
    {
      "path": "/api/cron/jobs-scan",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/jobs-fetch",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/jobs-email",
      "schedule": "45 11 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/run-worker",
      "schedule": "* * * * *"
    }
  ]
}
